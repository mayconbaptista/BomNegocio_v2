alert_email = "seu-email@example.com"

# Cloudflare (painel do dominio > Overview > coluna API). O token NAO entra aqui:
# PowerShell: $env:CLOUDFLARE_API_TOKEN = "..."
# Permissoes do token: Account > Cloudflare Tunnel > Edit  +  Zone > DNS > Edit (so esta zona)
cloudflare_account_id = "0123456789abcdef0123456789abcdef"
cloudflare_zone_id    = "0123456789abcdef0123456789abcdef"
domain_name           = "meudominio.com.br"
app_subdomain         = "bneshop" # site: https://bneshop.meudominio.com.br | origem: bneshop-origin.meudominio.com.br

# Confirme no console quais classes estao disponiveis na sua conta antes do apply.
instance_type     = "t4g.small"
db_instance_class = "db.t4g.micro"

# Backend ligado em dias uteis 8h-20h (Brasilia); desliga todo dia 20h e 23h.
# false = 24/7 sem destruir nada (~US$ 32/mes: so cabe com US$ 200 de credito).
power_schedule_enabled = true
# Com os US$ 200 das atividades do Explore AWS, da para ampliar, ex.: todo dia 8h-22h:
# power_schedule = {
#   rds_start = "cron(40 7 * * ? *)"
#   ec2_start = "cron(0 8 * * ? *)"
#   ec2_stop  = "cron(0 22,23 * * ? *)"
#   rds_stop  = "cron(10 22,23 * * ? *)"
# }

# Budget mede consumo BRUTO (antes dos creditos). 16 = US$ 100 / 6 meses.
monthly_budget_usd = 16

# github_backend_repository  = "owner/BomNegocio_v2"
# github_frontend_repository = "owner/bnEshop-ecommerce"

# A senha master NAO entra neste arquivo. Forneca somente no processo:
# PowerShell: $env:TF_VAR_db_master_password = "..."
# Bash:       export TF_VAR_db_master_password="..."
