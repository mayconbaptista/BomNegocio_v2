# Copie para .env.staging somente na EC2 ou no pipeline. Nao commite o arquivo real.
AWS_REGION=us-east-1

BNSHOP_API_HOST=api.bnshop.seudominio.dev
ACME_EMAIL=seu-email@example.com
CF_DNS_API_TOKEN=token-cloudflare-com-escopo-dns-edit

AUTH_VALID_AUDIENCE=https://bnshop.seudominio.dev
AUTH_VALID_ISSUER=bn-auth-sso
AUTH_SIGNING_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes
AUTH_REFRESH_MINUTES=1440
AUTH_TOKEN_MINUTES=60

AUTH_DB_CONNECTION=Host=seu-rds;Database=auth;Username=auth_app;Password=troque
CART_DB_CONNECTION=Host=seu-rds;Database=cart;Username=cart_app;Password=troque
CATALOG_DB_CONNECTION=Host=seu-rds;Database=catalog;Username=catalog_app;Password=troque
ORDER_DB_CONNECTION=Host=seu-rds;Database=orders;Username=order_app;Password=troque

CATALOG_BUCKET=bnshop-staging-catalog
EFI_CERTIFICATE_HOST_PATH=/opt/bnshop/secrets/efi-certificate.p12
EFI_CERTIFICATE_PASSWORD=troque
