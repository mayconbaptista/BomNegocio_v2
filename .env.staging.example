# Contrato das variaveis do docker-compose.staging.yml.
# Na EC2 este arquivo e GERADO pelo deploy/staging/deploy.sh a partir do
# Parameter Store, em /run/bnshop/staging.env (tmpfs). Nao commite valores reais.
# Na EC2, vem dos metadados da instancia (IMDS): sempre a regiao real.
AWS_REGION=us-east-2
LOG_LEVEL=Warning

# Header secreto CloudFront -> Traefik (SSM: secrets/origin-verify-secret)
ORIGIN_VERIFY_SECRET=gerado-pelo-terraform

# Token do cloudflared (SSM: secrets/cloudflare-tunnel-token, gerado pelo Terraform)
CLOUDFLARE_TUNNEL_TOKEN=gerado-pelo-terraform

# Imagens imutaveis (tag = git sha)
GATEWAY_IMAGE=<account>.dkr.ecr.us-east-2.amazonaws.com/bnshop/gateway:<sha>
AUTH_IMAGE=<account>.dkr.ecr.us-east-2.amazonaws.com/bnshop/auth:<sha>
CART_IMAGE=<account>.dkr.ecr.us-east-2.amazonaws.com/bnshop/cart:<sha>
CATALOG_IMAGE=<account>.dkr.ecr.us-east-2.amazonaws.com/bnshop/catalog:<sha>
ORDER_IMAGE=<account>.dkr.ecr.us-east-2.amazonaws.com/bnshop/order:<sha>

AUTH_VALID_AUDIENCE=https://bneshop.rascunhando.dev
AUTH_VALID_ISSUER=bn-auth-sso
AUTH_SIGNING_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes
AUTH_REFRESH_MINUTES=1440
AUTH_TOKEN_MINUTES=60

# RDS PostgreSQL 16 exige TLS por padrao (rds.force_ssl=1)
AUTH_DB_CONNECTION=Host=seu-rds;Database=auth;Username=auth_app;Password=troque;SSL Mode=Require
CART_DB_CONNECTION=Host=seu-rds;Database=cart;Username=cart_app;Password=troque;SSL Mode=Require
CATALOG_DB_CONNECTION=Host=seu-rds;Database=catalog;Username=catalog_app;Password=troque;SSL Mode=Require
ORDER_DB_CONNECTION=Host=seu-rds;Database=orders;Username=order_app;Password=troque;SSL Mode=Require

CATALOG_BUCKET=bnshop-staging-<account>-catalog
EFI_CERTIFICATE_HOST_PATH=/opt/bnshop/secrets/efi-certificate.p12
EFI_CERTIFICATE_PASSWORD=
