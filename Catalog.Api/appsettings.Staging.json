{
    "CorsPolicies": {
        "AllowSpecificOrigins": {
            "Origins": [ "http://localhost:4200" ],
            "Methods": [ "GET", "POST", "PUT", "DELETE" ],
            "Headers": [ "Content-Type" ],
            "AllowCredentials": true
        },
        "AllowAll": {
            "Origins": [ "*" ],
            "Methods": [ "GET" ],
            "Headers": [ "*" ],
            "AllowCredentials": false
        }
    },
    "AWS": {
        "S3": {
            "Region": "us-east-1",
            "AuthenticationRegion": "us-east-1",
            "ForcePathStyle": true,
            "Timeout": 30
        },
        "Region": "us-east-1",
        "AuthenticationRegion": "us-east-1",
        "Timeout": 30
    },
    "AllowedHosts": "*"
}
