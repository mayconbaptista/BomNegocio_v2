{
    "CorsPolicies": {
        "AllowSpecificOrigins": {
            "Origins": [ "http://localhost:4200" ],
            "Methods": [ "GET", "POST", "PUT", "DELETE" ],
            "Headers": [ "Content-Type", "Authorization" ],
            "AllowCredentials": true
        },
        "AllowAll": {
            "Origins": [ "*" ],
            "Methods": [ "GET", "POST", "PUT", "DELETE" ],
            "Headers": [ "*" ],
            "AllowCredentials": false
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Debug",
            "Ocelot": "Debug"
        }
    }
}
