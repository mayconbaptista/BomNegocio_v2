{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "RefreshLifeTimeInMinutes": 60,
        "TokenLifeTimeInMinutes": 60
      }
    }
  },
  "AllowedHosts": "*"
}
