{
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Debug"
        }
    },
    "AWS": {
        "S3": {
            "Region": "us-east-1",
            "AuthenticationRegion": "us-east-1",
            "ForcePathStyle": true,
            "Timeout": 30
        },
        "Region": "us-east-1",
        "AuthenticationRegion": "us-east-1",
        "Timeout": 30
    },
    "EFI": {
        "BaseUrl": "https://pix-h.api.efipay.com.br/",
        "Endpoints": {
            "OauthToken": "oauth/token",
            "CreatePix": "v2/cob",
            "GetPix": "v2/cob/{txid}",
            "WebHook": "v2/webhook/{chave}"
        }
    }
}
